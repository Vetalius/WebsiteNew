
<!DOCTYPE html>
<html lang="et">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WEXA | Soodsad laadimisjaamad</title>
  <meta name="description" content="WEXA - Nutikas elektriautode laadimislahendus korterühistutele. Automaatne arveldus ja koormuse juhtimine.">
  <link rel="icon" type="image/png" href="favicon-32x32.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;600;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
<!-- Add these meta tags -->
<meta property="og:title" content="WEXA | Nutikas laadimislahendus kortermajadele">
<meta property="og:description" content="Kontrollitud elektriautode laadimine korteriühistutele. Lihtne, õiglane ja tasuv.">
<meta property="og:url" content="https://wexa.ee">
<meta property="og:type" content="website">
<meta property="og:image" content="https://wexa.ee/wexa-promo.png">

<!-- Structured Data (Schema.org) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Wexa Technologies OÜ",
  "url": "https://wexa.ee",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Sepise 1",
    "addressLocality": "Tallinn",
    "postalCode": "11415",
    "addressCountry": "EE"
  },
  "telephone": "+37258666199",
  "email": "info@wexa.ee",
  "description": "Nutikas elektriautode laadimislahendus kortermajadele"
}
</script>
</head>
<body>

<!-- Custom cursor -->
<div id="cursor-dot"></div>
<div id="cursor-ring"></div>

<!-- Scroll progress -->
<div id="scroll-progress"></div>

<!-- Ambient background -->
<div class="orb-container">
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
</div>
<div class="noise-overlay"></div>
<canvas id="particle-canvas"></canvas>

<header id="header">
  <nav>
    <a href="#home" class="logo">
      <img src="wexa final logo.png" alt="WEXA" height="38">
    </a>
    <button class="menu-toggle" id="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-links" id="nav-links" role="navigation">
      <a href="#home"        data-key="nav_home">Avaleht</a>
      <a href="#solution"   data-key="nav_solution">Lahendus</a>
      <a href="#howwork"    data-key="nav_how">Kuidas WEXA töötab?</a>
      <a href="#contact"    data-key="nav_contact">Kontakt</a>
    </div>
    <div class="lang-switcher">
      <button class="lang-btn active" data-lang="et">ET</button>
      <button class="lang-btn" data-lang="en">EN</button>
      <button class="lang-btn" data-lang="ru">RU</button>
    </div>
  </nav>
</header>

<main>

  <!-- ── HERO ────────────────────────────────────────── -->
  <section class="hero" id="home">
    <div class="video-background">
<video autoplay muted loop playsinline poster="fallback-image.jpg" preload="none">
  <source src="car-charger.mp4" type="video/mp4">
</video>
    </div>

    <div class="hero-content reveal">
      <div class="hero-badge" data-key="hero_badge">Uus toode</div>
      <h1 data-key="hero_h1">
        Nutikas <span class="hero-accent">energialahendus</span><br>kortermajadele.
      </h1>
      <p class="lead" data-key="hero_lead">
        WEXA võimaldab korteriühistel pakkuda elanikele kontrollitud elektriautode laadimist — ilma suure investeeringu ja keeruka halduseta.
      </p>
      <div class="hero-cta-group">
        <a href="#configurator" class="btn btn-primary" data-key="hero_btn">
          Loo oma lahendus
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#calculator" class="btn btn-ghost" data-key="hero_cta_secondary">
          Arvuta tasuvus
        </a>
      </div>
    </div>

    <div class="scroll-indicator">
      <div class="mouse"><div class="wheel"></div></div>
      <span data-key="scroll_indicator">Keri alla</span>
    </div>
  </section>

  <div class="sep"></div>

  <!-- ── WHY SECTION ─────────────────────────────────── -->
  <section id="whydontwork" class="reveal">
    <div style="text-align:center; margin-bottom:3.5rem;">
      <div class="section-eyebrow" data-key="why_eyebrow">Probleem</div>
      <h2 data-key="reason-section-title" class="section-title">
        Miks tavalised lahendused sageli<br><span class="hero-accent">ei tööta</span>?
      </h2>
    </div>
    <div class="grid stagger">
      <div class="card">
        <div class="card-number">01</div>
        <span class="card-icon">📈</span>
        <h3 data-key="why_card1_h">Suured alginvesteeringud</h3>
        <p data-key="why_card1_p">Traditsioonilised laadimislahendused nõuavad suuri eelinvesteeringuid ja keerukaid elektrisüsteemi ümberkorraldusi.</p>
      </div>
      <div class="card">
        <div class="card-number">02</div>
        <span class="card-icon">⚠️</span>
        <h3 data-key="why_card2_h">Keerukas haldamine</h3>
        <p data-key="why_card2_p">Laadimiste arvestus, arvete koostamine ja süsteemi hooldus võtab palju aega ja ressursse.</p>
      </div>
      <div class="card">
        <div class="card-number">03</div>
        <span class="card-icon">🤝</span>
        <h3 data-key="why_card3_h">Ebaõiglane jagamine</h3>
        <p data-key="why_card3_p">Kõik elanikud panustavad ühiselt, aga kasutavad vaid mõned. See ei ole õiglane lahendus.</p>
      </div>
    </div>
  </section>

  <div class="sep"></div>

  <!-- ── SOLUTION SECTION ────────────────────────────── -->
  <section id="solution" class="reveal">
    <div style="text-align:center; margin-bottom:3.5rem;">
      <div class="section-eyebrow" data-key="solution_eyebrow">WEXA lahendus</div>
      <h2 data-key="wexa-heading" class="section-title">
        Turvaline ja <span class="hero-accent">nutikas</span>
      </h2>
    </div>
    <div class="grid stagger" style="grid-template-columns: repeat(4, 1fr);">
      <div class="card">
        <div class="card-number">01</div>
        <span class="card-icon">🛡</span>
        <h4 data-key="sol_card1_h">Teraskorpus</h4>
        <p data-key="sol_card1_p">Kogu laadimissüsteem on turvaliselt kapis. Lihtne 230V ja/või 400V ühendus, sobib igale majale.</p>
      </div>
      <div class="card">
        <div class="card-number">02</div>
        <span class="card-icon">📱</span>
        <h4 data-key="sol_card2_h">Juhtimine mobiiliäpiga</h4>
        <p data-key="sol_card2_p">Elanikud kasutavad süsteemi läbi mobiiliäpi. Automaatne tarbimise ja kulu arvestus.</p>
      </div>
      <div class="card">
        <div class="card-number">03</div>
        <span class="card-icon">📚</span>
        <h4 data-key="sol_card3_h">Läbipaistev ja õiglane</h4>
        <p data-key="sol_card3_p">Elektrienergia tarbimine arvestatakse täpselt ja korteripõhiselt. Kõik kulud kajastatakse läbipaistvalt kommunaalarvetel.</p>
      </div>
      <div class="card">
        <div class="card-number">04</div>
        <span class="card-icon">📊</span>
        <h4 data-key="sol_card4_h">Reaalajas jälgimine</h4>
        <p data-key="sol_card4_p">Süsteem jälgib tarbimist ja koormust automaatselt, võimaldades ühistul lihtsalt planeerida energiakasutust.</p>
      </div>
    </div>
<div class="promo-images-container">
  <img src="wexa-promo.png" alt="Wexa Promo" class="promo-img">
  <img src="wexa wall.png" alt="Wexa Wall" class="promo-img">
</div>
  </section>

  <div class="sep"></div>

  <!-- ── HOW IT WORKS ────────────────────────────────── -->
  <section id="howwork" class="reveal">
    <div style="text-align:center; margin-bottom:3.5rem;">
      <div class="section-eyebrow" data-key="how_eyebrow">Protsess</div>
      <h2 data-key="how_it_works_title" class="section-title">
        Kuidas <span class="hero-accent">Wexa töötab</span>?
      </h2>
    </div>
    <div class="grid stagger" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
      <div class="card">
        <div class="card-number">01</div>
        <span class="card-icon">🔧</span>
        <h4 data-key="how_step1_h">Paigaldamine</h4>
        <p data-key="how_step1_p">Paigaldame süsteemi teie parklasse läbimõeldult ja efektiivselt.</p>
      </div>
      <div class="card">
        <div class="card-number">02</div>
        <span class="card-icon">⚙️</span>
        <h4 data-key="how_step2_h">Seadistamine</h4>
        <p data-key="how_step2_p">Seadistame süsteemi vastavalt teie maja võimsusele ja vajadustele.</p>
      </div>
      <div class="card">
        <div class="card-number">03</div>
        <span class="card-icon">📲</span>
        <h4 data-key="how_step3_h">Kasutamine</h4>
        <p data-key="how_step3_p">Laadimine toimub mobiiliäpi kaudu ning kulud registreeritakse automaatselt.</p>
      </div>
      <div class="card">
        <div class="card-number">04</div>
        <span class="card-icon">📶</span>
        <h4 data-key="how_step4_h">Haldamine</h4>
        <p data-key="how_step4_p">Korteriühistu lisab kulud kommunaalarvetele, kasutajad näevad kogu ülevaadet läbi mobiiliäpi.</p>
      </div>
    </div>
  </section>

  <div class="sep"></div>

  <!-- ── LOAD MANAGEMENT ─────────────────────────────── -->
  <section id="loadcont" class="reveal">
    <div style="text-align:center; margin-bottom:3.5rem;">
      <div class="section-eyebrow" data-key="load_eyebrow">Tehniline eelis</div>
      <h2 data-key="load_management_title" class="section-title">
        Koormuse <span data-key="load_management_accent" class="hero-accent">juhtimine</span>
      </h2>
      <p data-key="wexa_system_description" style="font-size:1.1rem; color:var(--text-m); max-width:520px; margin:0 auto;">
        WEXA süsteem jälgib elektritarbimist reaalajas ja jaotab koormused automaatselt, et:
      </p>
    </div>
    <div class="grid stagger" style="grid-template-columns: repeat(3, 1fr); gap:1.5rem;">
      <div class="card" style="text-align:center;">
        <span class="card-icon">⚖️</span>
        <p data-key="load_point1">vältida ülekoormust ja elektrisüsteemi kahjustusi</p>
      </div>
      <div class="card" style="text-align:center;">
        <span class="card-icon">🔑</span>
        <p data-key="load_point2">tagada seadmete turvalise ja tõhusa kasutamise</p>
      </div>
      <div class="card" style="text-align:center;">
        <span class="card-icon">✅</span>
        <p data-key="load_point3">lihtsustada energiakasutuse planeerimist</p>
      </div>
    </div>
  </section>

  <div class="sep"></div>

  <!-- ── FACTS ───────────────────────────────────────── -->
  <section id="facts" class="reveal">
    <div style="text-align:center; margin-bottom:3.5rem;">
      <div class="section-eyebrow" data-key="facts_eyebrow">Andmed</div>
      <h2 data-key="facts_numbers_title" class="section-title">
        Faktid ja <span data-key="facts_numbers_accent" class="hero-accent">numbrid</span>
      </h2>
      <p data-key="wexa_necessity_text" style="color:var(--text-l); font-size:1rem; margin-top:0.5rem;">Miks WEXA lahendus on Eestis vajalik?</p>
    </div>
    <div class="facts-grid stagger">
      <div class="fact-card">
        <div class="fact-icon-wrap">🏠</div>
        <div class="fact-number" data-target="68" data-suffix="%">0%</div>
        <div class="fact-label" data-key="apartment_dwellers_stat_text">Eesti elanikest elab korterelamutes</div>
      </div>
      <div class="fact-card">
        <div class="fact-icon-wrap">🚗</div>
        <div class="fact-number" data-target="10000" data-suffix="+">0</div>
        <div class="fact-label" data-key="ev_count_estonia_text">elektriautot Eestis</div>
      </div>
      <div class="fact-card">
        <div class="fact-icon-wrap">📈</div>
        <div class="fact-number" data-target="15" data-suffix="%">0%</div>
        <div class="fact-label" data-key="ev_growth_2024_2025_text">elektriautode kasv 2024-2025</div>
      </div>
      <div class="fact-card">
        <div class="fact-icon-wrap">🏢</div>
        <div class="fact-number" data-target="25000" data-suffix="+">0</div>
        <div class="fact-label" data-key="apartment_solution_needed_text">kortermaja vajab lahendust</div>
      </div>
    </div>
  </section>

  <div class="sep"></div>

  <!-- ── CALCULATOR ──────────────────────────────────── -->
  <section id="calculator" class="reveal">
    <div style="text-align:center; margin-bottom:3rem;">
      <div class="section-eyebrow" data-key="calculator_eyebrow">Kalkulaator</div>
      <h2 data-key="roi-calculator-title" class="section-title">
        Kiire <span class="hero-accent">tasuvuskalkulaator</span>
      </h2>
    </div>
    <div class="calc-card">
      <div class="calc-columns">
        <div class="calc-column">
          <h3 data-key="calc_input_h">Sisendandmed</h3>
          <div class="input-group"><label data-key="calc_label_autos">Elektriautode arv ühistus</label><input type="number" id="autoArv" value="4" oninput="calculate()"></div>
          <div class="input-group"><label data-key="calc_label_km">Läbisõit 1 auto kohta kuus (km)</label><input type="number" id="labisoit" value="1500" oninput="calculate()"></div>
          <div class="input-group"><label data-key="calc_label_ev_eff">Elektriauto kulu (kWh/100km)</label><input type="number" id="evKulu" value="20" oninput="calculate()"></div>
          <div class="input-group"><label data-key="calc_label_el_price">Elektri lõpphind (€/kWh)</label><input type="number" id="elekterHind" step="0.01" value="0.16" oninput="calculate()"></div>
          <div class="input-group"><label data-key="calc_label_ice_eff">Vana auto kütusekulu (L/100km)</label><input type="number" id="iceKulu" step="0.1" value="5.5" oninput="calculate()"></div>
          <div class="input-group"><label data-key="calc_label_fuel_price">Kütuse hind (€/L)</label><input type="number" id="kutuseHind" step="0.01" value="1.80" oninput="calculate()"></div>
        </div>
        <div class="calc-column">
          <h3 data-key="calc_res_h">Võrdlus ja tulemused</h3>
          <div class="results-box">
            <div class="comparison">
              <div class="comp-card ev-card">
                <span class="comp-title" data-key="calc_ev_cost_title">ELEKTRIAUTO KULU</span>
                <span class="comp-val" id="resEvKuluKuu">0</span>
                <small data-key="currency_per_month">€/kuu</small>
              </div>
              <div class="comp-card ice-card">
                <span class="comp-title" data-key="calc_ice_cost_title">TAVA-AUTO KULU</span>
                <span class="comp-val" id="resIceKuluKuu">0</span>
                <small data-key="ice_cost_per_month">€/kuu</small>
              </div>
            </div>
            <div class="output-item"><span data-key="calc_save_auto">Sääst 1 auto kohta kuus:</span><span class="display-value" id="resSaastAuto">0</span></div>
            <div class="output-item"><span data-key="calc_save_ky">Sääst kogu KÜ kohta kuus:</span><span class="display-value" id="resSaastKu">0</span></div>
            <div class="output-item"><span data-key="calc_invest">Investeering alates:</span><span class="display-value" id="resInvesteering">0</span></div>
            <div class="highlight-box">
              <span class="highlight-label" data-key="calc_payback_label">Hinnanguline tasuvusaeg</span>
              <span class="highlight-value">
                <span id="resTasuvus">0</span>
                <span id="paybackMonthsSuffix" data-key="months" style="font-size:1.2rem; font-weight:400;"> kuud</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="sep"></div>

  <!-- ── CONFIGURATOR ────────────────────────────────── -->
  <section id="configurator" class="reveal" x-data="deviceCalculator()" x-on:language-changed.window="currentLang = $event.detail">
    <div style="text-align:center; margin-bottom:3rem;">
      <div class="section-eyebrow" data-key="configurator_eyebrow">Hinnapäring</div>
      <h2 class="section-title" data-key="conf_title">
        Loo oma <span class="hero-accent" data-key="conf_accent">lahendus</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <div class="card">
          <h3 data-key="house_equipment_title" class="text-xl font-bold mb-6 text-orange-400">Maja ja seadmete andmed</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
            <div>
              <label data-key="installation_address_label" class="block text-xs font-medium mb-2 text-gray-400 uppercase tracking-wider">Paigalduse aadress</label>
              <div class="address-input-wrap">
                <input type="text" x-model="form.address" data-placeholder-key="installation_address_placeholder" placeholder="Tänav, maja, linn"
                  class="w-full p-3 rounded-xl wexa-calc-input focus:outline-none"
                  @input.debounce.300ms="fetchAddressSuggestions"
                  @keydown.arrow-down.prevent="addrHighlight = Math.min(addrHighlight + 1, addrSuggestions.length - 1)"
                  @keydown.arrow-up.prevent="addrHighlight = Math.max(addrHighlight - 1, 0)"
                  @keydown.enter.prevent="addrHighlight >= 0 && selectAddress(addrSuggestions[addrHighlight])"
                  @keydown.escape="addrSuggestions = []"
                  @blur.debounce.150ms="addrSuggestions = []" autocomplete="off"/>
                <div class="address-dropdown" x-show="addrSuggestions.length > 0" x-cloak>
                  <template x-for="(s, idx) in addrSuggestions" :key="s.adr_id || idx">
                    <div class="address-dropdown-item" :class="{'active-item': addrHighlight === idx}"
                      @mousedown.prevent="selectAddress(s)" @mouseover="addrHighlight = idx">
                      <span x-text="s.ipikkaadress || s.aadresstekst"></span>
                    </div>
                  </template>
                </div>
              </div>
            </div>
            <div>
              <label data-key="conf_main_fuse_label" class="block text-xs font-medium mb-2 text-gray-400 uppercase tracking-wider">Maja peakaitse (A)</label>
              <input type="number" x-model="form.peakaitse" class="w-full p-3 rounded-xl wexa-calc-input focus:outline-none">
            </div>
          </div>
          <div class="space-y-2">
            <template x-for="item in items" :key="item.id">
              <div class="flex items-center justify-between py-4 border-b border-white/5">
                <div>
                  <div class="font-semibold text-white" x-text="getTranslatedItemName(item)"></div>
                  <div class="text-xs text-gray-500 mt-0.5"><span data-key="conf_unit_price_label">Ühikuhind</span>: <span x-text="item.price"></span>€</div>
                </div>
                <div class="flex items-center space-x-3">
                  <button @click="if(item.qty > 0) item.qty--" class="w-9 h-9 rounded-lg bg-white/5 text-white border border-white/10 cursor-none hover:bg-orange-500 hover:border-orange-500 transition-all duration-200 font-bold text-lg">−</button>
                  <span class="w-8 text-center font-bold text-orange-400 text-xl tabular-nums" x-text="item.qty"></span>
                  <button @click="item.qty++" class="w-9 h-9 rounded-lg bg-white/5 text-white border border-white/10 cursor-none hover:bg-orange-500 hover:border-orange-500 transition-all duration-200 font-bold text-lg">+</button>
                </div>
              </div>
            </template>
          </div>
        </div>

        <div class="card">
          <h3 data-key="installation_package_title" class="text-xl font-bold mb-2 text-orange-400">Paigalduspakett</h3>
          <p data-key="distance_selection_text" class="text-sm text-gray-500 mb-5">Valige kaugus peakilbi ja esimese seadme vahel:</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <template x-for="pkg in packages" :key="pkg.id">
              <div @click="selectedPackageId = pkg.id" :class="{'active': selectedPackageId === pkg.id}"
                class="package-card p-4 flex flex-col items-start space-y-2">
                <div class="radio-dot w-4 h-4 rounded-full flex items-center justify-center">
                  <div class="w-2 h-2 rounded-full" :class="selectedPackageId === pkg.id ? 'bg-black' : 'bg-transparent'" x-show="selectedPackageId === pkg.id"></div>
                </div>
                <div class="font-bold text-sm" x-text="getTranslatedPackageName(pkg.id)"></div>
                <div class="text-[10px] text-gray-500 uppercase tracking-wide"><span data-key="conf_base_label">Baas</span>: <span x-text="pkg.basePrice"></span>€</div>
              </div>
            </template>
          </div>
        </div>
      </div>

      <div>
        <div class="card card-glow" style="position:sticky; top:110px;">
          <h3 data-key="conf_selected_solution_title" class="text-lg font-bold mb-5">Valitud lahendus</h3>
          <div class="space-y-3 text-sm mb-6">
            <div class="flex justify-between items-center text-gray-400">
              <span data-key="conf_total_devices_label">Seadmeid kokku:</span>
              <span class="text-white font-bold tabular-nums" x-text="totalQty"></span>
            </div>
            <div class="flex justify-between items-center text-gray-400">
              <span data-key="conf_package_label">Pakett:</span>
              <span class="text-white font-bold" x-text="selectedPackageName"></span>
            </div>
            <div class="pt-4 border-t border-white/5 flex justify-between items-end">
              <span data-key="conf_estimated_cost_label" class="text-gray-400 text-sm">Orienteeruv maksumus:</span>
              <div class="text-3xl font-black" style="background:linear-gradient(135deg,var(--accent),var(--accent-light));background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent;">
                <span x-text="seadmeteMaksumus + paigalduseMaksumus"></span>€
              </div>
            </div>
          </div>

<form id="configForm" action="https://api.web3forms.com/submit" method="POST" @submit.prevent="sendConfiguration" class="space-y-3">
  
  <input type="hidden" name="access_key" value="9033af9e-1cc3-4352-ace5-1dbbb32e3542">

  <input type="hidden" name="subject" value="Uus laadimissüsteemi kalkulatsioon - WEXA">

  <input type="hidden" name="aadress" x-model="form.address">
  <input type="hidden" name="peakaitse" x-model="form.peakaitse">
  <input type="hidden" name="valitud_pakett" :value="selectedPackageName">
  <input type="hidden" name="seadmeid_kokku" :value="totalQty">
  <input type="hidden" name="kogumaksumus" :value="seadmeteMaksumus + paigalduseMaksumus + '€'">
  <template x-for="item in items">
    <input type="hidden" :name="'toode_' + item.id" :value="getTranslatedItemName(item) + ': ' + item.qty + ' tk'">
  </template>

  <input type="text"  name="nimi"    x-model="form.name"    data-placeholder-key="conf_name_placeholder"    placeholder="Teie nimi" required class="w-full p-3 rounded-xl wexa-calc-input text-sm">
  <input type="email" name="email"   x-model="form.email"   data-placeholder-key="conf_email_placeholder"   placeholder="E-post"    required class="w-full p-3 rounded-xl wexa-calc-input text-sm">
  <input type="text"  name="telefon" x-model="form.phone"   data-placeholder-key="conf_phone_placeholder"   placeholder="Telefon"   required class="w-full p-3 rounded-xl wexa-calc-input text-sm">
  <textarea name="lisainfo" x-model="form.message" data-placeholder-key="conf_message_placeholder" placeholder="Lisainfo..." class="w-full p-3 rounded-xl wexa-calc-input text-sm" rows="3"></textarea>

  <button type="submit" :disabled="loading" class="btn btn-primary w-full justify-center">
    <span x-text="loading ? getI18nText('conf_submit_loading_text','Saadan...') : getI18nText('conf_submit_button_text','Saada hinnapäring')"></span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
  </button>
  <p x-show="success" data-key="conf_success_message" class="text-emerald-400 text-center text-xs mt-2" style="display:none;">✓ Päring edukalt saadetud!</p>
</form>
        </div>
      </div>
    </div>
  </section>

  <div class="sep"></div>

  <!-- ── CONTACT ─────────────────────────────────────── -->
  <section id="contact" class="reveal">
    <div class="contact-container">
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="section-eyebrow" data-key="contact_eyebrow">Kontakt</div>
        <h2 data-key="contact_section_title" class="section-title" style="margin-bottom:1rem;">
          Võta <span data-key="contact_section_accent" class="hero-accent">ühendust</span>
        </h2>
        <div style="display:flex; flex-direction:column; gap:1rem;">
          <div class="contact-info-item">
            <div class="contact-icon-box">✉️</div>
            <div>
              <small data-key="contact_email_label" style="color:var(--accent); text-transform:uppercase; font-weight:700; letter-spacing:1px; font-size:0.7rem; display:block; margin-bottom:4px;">E-mail</small>
              <a href="/cdn-cgi/l/email-protection#462f2820290631233e27682323" style="color:var(--text); text-decoration:none; font-size:1.05rem; font-weight:500;"><span class="__cf_email__" data-cfemail="d0b9beb6bf90a7b5a8b1feb5b5">[email&#160;protected]</span></a>
            </div>
          </div>
          <div class="contact-info-item">
            <div class="contact-icon-box">📞</div>
            <div>
              <small data-key="contact_phone_label" style="color:var(--accent); text-transform:uppercase; font-weight:700; letter-spacing:1px; font-size:0.7rem; display:block; margin-bottom:4px;">Telefon</small>
              <a id="phone-link" href="tel:+37258666199" data-key="footer_phone"
                 style="color:var(--text); text-decoration:none; font-size:1.05rem; font-weight:500;">+372 5866 6199</a>
            </div>
          </div>
          <div class="contact-info-item">
            <div class="contact-icon-box">📍</div>
            <div>
              <small data-key="contact_address_label" style="color:var(--accent); text-transform:uppercase; font-weight:700; letter-spacing:1px; font-size:0.7rem; display:block; margin-bottom:4px;">Aadress</small>
              <span style="font-size:1.05rem; font-weight:500;">Sepise 1, 11415 Tallinn</span>
            </div>
          </div>
        </div>
      </div>

      <div class="map-wrapper">
        <iframe
          data-key="map_title" title="WEXA asukoht kaardil"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2029.28827725458!2d24.8000!3d59.4260!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4692eb5ad0000001%3A0x0!2sSepise%201%2C%2011415%20Tallinn!5e0!3m2!1set!2see!4v1700000000000"
          allowfullscreen="" 
